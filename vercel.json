{
  "rewrites": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "cardwhispers.joyfulnesspath.com" }],
      "destination": "/cardwhispers/index.html"
    },
    {
      "source": "/index.html",
      "has": [{ "type": "host", "value": "cardwhispers.joyfulnesspath.com" }],
      "destination": "/cardwhispers/index.html"
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "cardwhispers.joyfulnesspath.com" }],
      "destination": "/cardwhispers/:path*"
    },
    {
      "source": "/",
      "destination": "/home.html"
    },
    {
      "source": "/index.html",
      "destination": "/home.html"
    }
  ]
}
